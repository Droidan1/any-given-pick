# Managed by the Clerk integration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_PROXY_URL=

# Temporary free-entry safeguard. Set to false later to let new verified accounts enter immediately.
USER_APPROVAL_REQUIRED=true

# Shared by the production score-sync endpoint and its scheduler.
CRON_SECRET=

# Hashes rate-limit identifiers. Use a different high-entropy value in each environment.
RATE_LIMIT_SECRET=

# Direct support and privacy-request destination shown throughout the app.
SUPPORT_EMAIL=brian@Droidan1.dev

# Optional automated privacy-request and operations alerts. Mailto support still works when unset.
RESEND_API_KEY=
EMAIL_FROM=Any Given Pick <alerts@anygivenpick.app>

# Managed by the Neon integration
DATABASE_URL=
DATABASE_URL_UNPOOLED=
