{
  "name": "any-given-pick",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:critical": "vitest run lib/entries/draft-conflict.test.ts lib/entries/draft-storage.test.ts lib/entries/official-receipt.test.ts lib/admin/game-recovery-policy.test.ts lib/results/rules.test.ts lib/deadline/countdown.test.ts",
    "monitor:preview": "checkly deploy --preview --verbose",
    "monitor:deploy": "checkly deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "dotenv -e .env.local -- tsx scripts/seed-database.ts",
    "db:grant-admin": "dotenv -e .env.local -- tsx scripts/grant-admin.ts",
    "db:verify": "dotenv -e .env.local -- tsx scripts/verify-database.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.5",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@vercel/functions": "^3.8.0",
    "@vercel/speed-insights": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/web-push": "^3.6.4",
    "checkly": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.8",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
